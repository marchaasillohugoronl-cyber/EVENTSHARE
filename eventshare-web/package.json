    "jose": "^5.9.6",
    "next": "^15.5.26",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
