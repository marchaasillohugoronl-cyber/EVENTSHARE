# Base de datos (Neon: usa la cadena "pooled")
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secretos JWT (genera con: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# URL pública de la app (se usa para construir los enlaces del QR)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Orígenes adicionales permitidos para peticiones con cookies (separados por coma). Opcional.
ALLOWED_ORIGINS=

# Registro público de administradores (true/false)
ALLOW_ADMIN_REGISTRATION=true

# Google Sign-In (opcional). Crea un "OAuth client ID" tipo Web en Google Cloud Console.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudinary (solo servidor; nunca usar NEXT_PUBLIC_ para el secreto)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
